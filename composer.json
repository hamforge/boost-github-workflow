{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "hamforge/boost-github-workflow",
  "description": "Laravel Boost skills for hamforge's GitHub development workflow.",
  "keywords": [
    "laravel",
    "hamforge",
    "boost-github-workflow"
  ],
  "homepage": "https://hamforge.dev",
  "support": {
    "issues": "https://github.com/hamforge/boost-github-workflow/issues",
    "source": "https://github.com/hamforge/boost-github-workflow"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "hamforge",
      "email": "hello@hamforge.dev",
      "role": "Developer"
    }
  ],
  "require-dev": {
    "laravel/pint": "^1.29",
    "laravel/pao": "^1.0",
    "pestphp/pest": "^5.2",
    "phpstan/phpstan": "^2.1",
    "symfony/yaml": "^7.3||^8.0"
  },
  "scripts": {
    "lint": [
      "vendor/bin/pint --parallel"
    ],
    "lint:check": [
      "vendor/bin/pint --parallel --test"
    ],
    "analyse": [
      "vendor/bin/phpstan analyse"
    ],
    "test:unit": [
      "vendor/bin/pest --parallel"
    ],
    "test": [
      "@analyse",
      "@lint:check",
      "@test:unit"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "archive": {
    "exclude": [
      "/.DS_Store",
      "/.agents",
      "/.claude",
      "/.github",
      "/.phpunit.cache",
      "/AGENTS.md",
      "/CLAUDE.md",
      "/build",
      "/composer.lock",
      "/phpstan.neon.dist",
      "/phpunit.xml.dist",
      "/pint.json",
      "/src",
      "/tests",
      "/tmp",
      "/vendor",
      "/workbench"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
